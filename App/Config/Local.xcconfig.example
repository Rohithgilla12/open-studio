// Copy to Local.xcconfig (gitignored). TCC keys a grant to the app's signature; an ad hoc build's
// signature changes on every rebuild, so each rebuild loses Screen Recording and Input Monitoring.
// A stable identity keeps them.

// With an Apple ID (a free personal team works): your ten-character team id.
DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development

// Without one: a self-signed code-signing certificate from Keychain Access, by name.
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Open Studio Local
